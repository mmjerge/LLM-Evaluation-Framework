\[ (c^2 + 10c + 25) + (144 - 48c + 4c^2) + c^2 = 109 \]
\[ 6c^2 - 38c + 169 = 109 \]
\[ 6c^2 - 38c + 60 = 0 \]
\[ 3c^2 - 19c + 30 = 0 \]
